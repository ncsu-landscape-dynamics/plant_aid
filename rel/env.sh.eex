export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=<%= @release.name %>@${POD_IP}

# Cap the Erlang port table. Newer Kubernetes nodes give containers an open-file
# limit of ~1 billion; the VM sizes its port table from that and allocates >2 GB
# at boot (plant-aid.org outage, Oct–Nov 2026). 65536 keeps memory at ~200 MB.
# A value set in the Deployment env still takes precedence.
export ERL_MAX_PORTS="${ERL_MAX_PORTS:-65536}"
